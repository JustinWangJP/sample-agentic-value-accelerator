#!/bin/sh

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1
. applications/registry_portal/scripts/dev-env.sh
exec applications/registry_portal/backend/.venv/bin/python -m pre_commit hook-impl \
  --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir=.githooks -- "$@"
