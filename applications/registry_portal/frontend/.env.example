# Registry ポータル SPA の設定例。.env.local にコピーして値を設定する（コミットしない）。
# いずれかが未設定の場合、SPA は起動時にエラーを表示し、ログイン処理を行わない。
#
# ローカルの開発サーバー（npm run dev）から dev の API と Cognito に接続する場合は、本体スタックの
# output frontend_config の値を設定し、VITE_REDIRECT_URI だけを http://localhost:5173/ にする。
# dev の tfvars の local_dev_origins に http://localhost:5173 を含めて反映しておく
# （README「ローカルの開発サーバーから dev に接続する」）。

# Cognito のドメイン（managed login / Hosted UI）
VITE_COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
# 人間用の公開 SPA client（Authorization Code + PKCE、secret なし）
VITE_COGNITO_CLIENT_ID=
# Cognito の client に登録したコールバック URL。ローカルの開発サーバーでは http://localhost:5173/（local_dev_origins に末尾の / を付けた値）
VITE_REDIRECT_URI=http://localhost:5173/
# REST API のベース URL（ステージ /v1 を含める。末尾の / は不要）
VITE_API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com/v1
# openid と、REST API の route が要求するカスタム scope（本体スタックの output portal_api_scope）をスペース区切りで指定する
VITE_COGNITO_SCOPES=openid registry-portal/api.invoke
