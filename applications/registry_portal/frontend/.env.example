# Registry ポータル SPA の設定例。.env.local にコピーして値を設定する（コミットしない）。
# いずれかが未設定の場合、SPA は起動時にエラーを表示し、ログイン処理を行わない。

# Cognito のドメイン（managed login / Hosted UI）
VITE_COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
# 人間用の公開 SPA client（Authorization Code + PKCE、secret なし）
VITE_COGNITO_CLIENT_ID=
# Cognito の client に登録したコールバック URL
VITE_REDIRECT_URI=http://localhost:5173/
# HTTP API のベース URL（末尾の / は不要）
VITE_API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com
# 要求する scope（スペース区切り。省略時は openid）
# JWT authorizer で route ごとの scope を検証する場合は、ポータル用のカスタム scope を含める（#5 で定義）
VITE_COGNITO_SCOPES=openid
