# terraform.tfvars にコピーして値を設定する。terraform.tfvars はコミットしない
region                   = "us-east-1"
management_role_name     = "registry-portal-management"
registry_arn             = "arn:aws:agent-registry:us-east-1:123456789012:registry/abcdEFGH1234"
supplement_table_arn     = "arn:aws:dynamodb:us-east-1:123456789012:table/registry-auxiliary"
management_function_name = "registry-portal-management"
# 本体スタックの output rest_api をそのまま転記する（terraform output rest_api）
rest_api = {
  id                   = "a1b2c3d4e5"
  stage_name           = "v1"
  authorizer_id        = "abc123"
  portal_api_scope     = "registry-portal/api.invoke"
  cors_allowed_origins = ["https://portal.example.cloudfront.net", "http://localhost:5173"]
}
