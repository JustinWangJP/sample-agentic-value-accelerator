aws_account_id              = "123456789012"
spa_bucket_name             = "registry-portal-dev-123456789012"
registry_arn                = "arn:aws:agent-registry:us-east-1:123456789012:registry/AbCdEf123456"
cognito_user_pool_id        = "us-east-1_Example"
cognito_domain              = "https://example.auth.us-east-1.amazoncognito.com"
identity_providers          = ["COGNITO"]
team_names                  = ["platform"]
discovery_token_url         = "https://example.auth.us-east-1.amazoncognito.com/oauth2/token"
discovery_client_id         = "existing-discovery-client"
discovery_client_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:registry-discovery-AbCdEf"
# discovery_kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
# discovery_scope = "existing-registry/discover"

# dev の費用を抑える設定。SPA バケットの古いバージョン（配信で置き換わったビルド）を 7 日で消す。
# 配信は手元のビルドを上書きするだけで、古いバージョンには頼らない（戻すときは前のコミットから配信し直す）。
# 指定しない（null）と古いバージョンを残し続ける。
spa_noncurrent_version_expiration_days = 7

# 撤去（destroy）するときだけ切り替える。通常は既定値（保護を有効）のまま指定しない。
# 切り替えて apply してから destroy する。補助テーブルの lifecycle.prevent_destroy は
# 変数にできないため、撤去時は main.tf の行を手元で外し、その変更はコミットしない。
# table_deletion_protection = false
# spa_force_destroy         = true
