{
  "terraform": {
    "required_version": ">= 1.10.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "management_role_name": {
      "type": "string",
      "description": "下書き API を実行する管理 Lambda の既存 IAM ロール名"
    },
    "registry_arn": {
      "type": "string",
      "description": "変更・削除せず借用する既存 Registry の ARN",
      "validation": {
        "condition": "${can(regex(\"^arn:aws:agent-registry:us-east-1:[0-9]{12}:registry/[A-Za-z0-9]{12,16}$\", var.registry_arn))}",
        "error_message": "us-east-1 の既存 Agent Registry ARN を指定してください。"
      }
    },
    "supplement_table_arn": {
      "type": "string",
      "description": "所有情報・ロック・冪等操作・追記記録を保存する補助 DynamoDB テーブル ARN",
      "validation": {
        "condition": "${can(regex(\"^arn:aws:dynamodb:us-east-1:[0-9]{12}:table/[A-Za-z0-9_.-]+$\", var.supplement_table_arn))}",
        "error_message": "補助 DynamoDB テーブルの ARN を指定してください。"
      }
    }
  },
  "locals": {
    "management_draft_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "RegistryDrafts",
          "Effect": "Allow",
          "Action": [
            "agent-registry:CreateRegistryRecord",
            "agent-registry:UpdateRegistryRecord",
            "agent-registry:GetRegistryRecord",
            "agent-registry:ListRegistryRecords"
          ],
          "Resource": ["${var.registry_arn}", "${var.registry_arn}/record/*"]
        },
        {
          "Sid": "DraftSupplement",
          "Effect": "Allow",
          "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem"],
          "Resource": "${var.supplement_table_arn}"
        }
      ]
    }
  },
  "resource": {
    "aws_iam_role_policy": {
      "management_drafts": {
        "name": "registry-portal-management-drafts",
        "role": "${var.management_role_name}",
        "policy": "${jsonencode(local.management_draft_policy)}"
      }
    }
  }
}
