{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventsLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "${log_group_arn}:*"
    },
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": ["agent-registry:GetRegistryRecord"],
      "Resource": ["${registry_arn}", "${registry_arn}/record/*"]
    },
    {
      "Sid": "SupplementRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "${supplement_table_arn}"
    },
    {
      "Sid": "NotificationWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "${supplement_table_arn}",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "REGISTRY#${registry_arn}#NOTIFICATION#*",
            "REGISTRY#${registry_arn}#NOTIFIED#*",
            "REGISTRY#${registry_arn}#EVENT#*"
          ]
        }
      }
    },
    {
      "Sid": "EventsDeadLetter",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "${dead_letter_queue_arn}"
    }
  ]
}
