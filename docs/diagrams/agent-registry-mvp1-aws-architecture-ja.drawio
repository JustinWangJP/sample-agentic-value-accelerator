<mxfile host="drawio"><diagram id="mvp1" name="MVP1 構成（ネットワーク含む）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1560" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AWS Agent Registry 管理ポータル MVP1 構成図（ネットワーク構成を含む）&lt;/b&gt;&lt;br&gt;計画図であり、デプロイ済みの構成ではない。基準: plan/aws-agent-registry-mvp1-design-ja.md・ADR-0001〜0004" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="60" as="geometry"/></mxCell><mxCell id="g_cloud" value="AWS アカウント" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="1700" height="1440" as="geometry"/></mxCell><mxCell id="g_region" value="リージョン us-east-1（VPC なし: すべて AWS マネージドの公開 HTTPS エンドポイント）" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#147EBA;fillColor=#f8fafc;dashed=1;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="1650" height="1170" as="geometry"/></mxCell><mxCell id="g_pub" value="公開エンドポイント（JWT で保護）" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#E7157B;fillColor=#fdf2f8;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="320" y="405" width="320" height="575" as="geometry"/></mxCell><mxCell id="g_lambda" value="AWS Lambda（VPC 非接続・Python）" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#ED7100;fillColor=#fff7ed;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="680" y="405" width="360" height="735" as="geometry"/></mxCell><mxCell id="g_reg" value="既存 Agent Registry（ARN 参照のみ）" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#147EBA;fillColor=#eff6ff;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1080" y="405" width="400" height="735" as="geometry"/></mxCell><mxCell id="g_data" value="データ（非公開・暗号化）" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#7AA116;fillColor=#f7fee7;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1520" y="405" width="400" height="735" as="geometry"/></mxCell><mxCell id="g_ops" value="監査・運用" style="html=1;whiteSpace=wrap;container=0;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingTop=6;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#64748b;fillColor=#f8fafc;dashed=0;spacingLeft=34;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="320" y="1190" width="1600" height="290" as="geometry"/></mxCell><mxCell id="n_net" value="&lt;b&gt;ネットワーク境界（ADR-0003）&lt;/b&gt;&lt;br&gt;・VPC・Subnet・NAT Gateway・Internet Gateway・VPC Endpoint・ALB・WAF・独自ドメインは作らない&lt;br&gt;・Lambda は VPC 非接続。AWS 管理ネットワークから TLS 443 で AWS API と IdP に接続する&lt;br&gt;・受信できる入口は CloudFront と API Gateway の標準ドメインだけ。Lambda Function URL は作らない&lt;br&gt;・閉域化・送信先の強制制限・WAF が必須になった場合は構成を見直す" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="880" height="110" as="geometry"/></mxCell><mxCell id="user" value="利用者（ブラウザ・React SPA）&lt;br&gt;Viewer・Publisher・Curator・Admin" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="70" height="70" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;CI・App Factory&lt;/b&gt;&lt;br&gt;サービス主体（専用 M2M）&lt;br&gt;下書き作成・申請のみ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;align=center;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="180" height="80" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;外部エージェント&lt;/b&gt;&lt;br&gt;MCP クライアント&lt;br&gt;（発見用 M2M JWT）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;align=center;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="180" height="80" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;オペレーター（ローカル端末）&lt;/b&gt;&lt;br&gt;scripts/deploy.sh を手動実行&lt;br&gt;plan → 目視確認 → apply →&lt;br&gt;SPA 同期 → CloudFront 無効化" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;align=center;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="190" height="110" as="geometry"/></mxCell><mxCell id="gha" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;テスト・Lint・型検査・&lt;br&gt;terraform fmt / validate のみ&lt;br&gt;AWS 認証情報なし（ADR-0004）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;align=center;fillColor=#f1f5f9;strokeColor=#94a3b8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="190" height="100" as="geometry"/></mxCell><mxCell id="cf" value="Amazon CloudFront&lt;br&gt;HTTPS・CSP・セキュリティヘッダー&lt;br&gt;OAC で S3 origin を制限" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="78" height="78" as="geometry"/></mxCell><mxCell id="apigw" value="API Gateway HTTP API&lt;br&gt;JWT authorizer&lt;br&gt;issuer・client_id・scope&lt;br&gt;CORS は SPA の origin のみ" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="78" height="78" as="geometry"/></mxCell><mxCell id="cognito" value="Amazon Cognito（既存 User Pool）&lt;br&gt;人間用 PKCE client（追加）&lt;br&gt;CI 用 M2M client（追加）&lt;br&gt;発見用 M2M client（既存）" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="440" y="720" width="78" height="78" as="geometry"/></mxCell><mxCell id="mgmt" value="管理 Lambda&lt;br&gt;発見の代理・下書き・申請・&lt;br&gt;廃止依頼・通知 API&lt;br&gt;状態変更の権限なし" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="78" height="78" as="geometry"/></mxCell><mxCell id="cur" value="決裁 Lambda&lt;br&gt;公開承認・却下・公開停止・&lt;br&gt;廃止・取り込み・回復&lt;br&gt;定義の作成・更新の権限なし" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="78" height="78" as="geometry"/></mxCell><mxCell id="evt" value="イベント処理 Lambda&lt;br&gt;Registry の読み取りと&lt;br&gt;通知の書き込みのみ" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="960" width="78" height="78" as="geometry"/></mxCell><mxCell id="ctrl" value="管理 API（agent-registry-control）&lt;br&gt;IAM SigV4・Boto3" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1"><mxGeometry x="1240" y="440" width="78" height="78" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Registry レコード&lt;/b&gt;（Agent・A2A・MCP サーバー・Skill）&lt;br&gt;定義と状態の正本（ADR-0002）&lt;br&gt;DRAFT → PENDING_APPROVAL → APPROVED&lt;br&gt;REJECTED・DEPRECATED / 自動承認は無効" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=11;fillColor=#dbeafe;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="1110" y="600" width="340" height="120" as="geometry"/></mxCell><mxCell id="disc" value="発見 API・Registry MCP（agent-registry）&lt;br&gt;JWT（発見用 M2M）&lt;br&gt;検索・一覧は Registry 単位の認可" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1"><mxGeometry x="1240" y="790" width="78" height="78" as="geometry"/></mxCell><mxCell id="eb" value="EventBridge default バス&lt;br&gt;ルール: aws.agent-registry の&lt;br&gt;レコード状態変化" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0]