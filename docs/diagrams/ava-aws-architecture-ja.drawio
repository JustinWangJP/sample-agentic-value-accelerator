        <mxCell id="port0" value="ブラウザ → CloudFront / HTTP API / Cognito  |  TCP443  |  公開HTTPS。OIDC外部接続は任意" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;rounded=0;align=left;fontSize=14;" vertex="1" parent="1">
