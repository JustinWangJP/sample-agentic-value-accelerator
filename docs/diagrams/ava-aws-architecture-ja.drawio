        </mxCell>
        <mxCell id="port2" value="Interface EP → ECR API / DKR / Logs  |  TCP443  |  EP SG: VPC CIDRから443 / private DNS有効" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;rounded=0;align=left;fontSize=14;" vertex="1" parent="1">
