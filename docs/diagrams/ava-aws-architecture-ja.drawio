          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="コネクタ有効時 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="cloud">
