  <diagram id="page-3" name="03 SaaS・任意Gateway">
    <mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03 / 外部SaaS・クラウド連携と任意Gateway" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
