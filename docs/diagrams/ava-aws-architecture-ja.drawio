        <mxCell id="lf" value="Langfuseは別Foundationでセルフホスト可&#xa;ホストURLは設定で解決 → 詳細04&#xa;Langfuse Cloud利用を既定と断定しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
