        <mxCell id="port1" value="VPC Link → 内部ALB → ECS API  |  TCP80 → TCP8000  |  ALB SG: 80/443 from 0.0.0.0/0（ALBはinternal） / ECS:8000 from ALB SG" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;rounded=0;align=left;fontSize=14;" vertex="1" parent="1">
