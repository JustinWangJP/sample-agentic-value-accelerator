<diagram id="page-2" name="02 VPC・Subnet・CIDR"><mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="02 / Control Plane — VPC・Subnet・IP範囲" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1740" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="infrastructure/variables.tf + modules/networking/main.tf | CIDRは10.0.0.0/16、AZ数2の既定値から算出。固定ホストIP・EIPは未指定。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=15;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="1740" height="60" as="geometry"/></mxCell><mxCell id="internet" value="Internet / AWS公開API・外部HTTPS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="540" height="65" as="geometry"/></mxCell><mxCell id="vpc" value="Control Plane VPC：10.0.0.0/16 | DNS support / hostnames有効" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="1720" height="1030" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&#xa;public RT: 0.0.0.0/0 → IGW" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="665" y="300" width="460" height="80" as="geometry"/></mxCell><mxCell id="aza" value="AZ-A：us-east-1a（既定）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="65" y="425" width="805" height="745" as="geometry"/></mxCell><mxCell id="azb" value="AZ-B：us-east-1b（既定）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="910" y="425" width="805" height="745" as="geometry"/></mxCell><mxCell id="puba" value="Public subnet A / 10.0.0.0/20" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="90" y="485" width="755" height="280" as="geometry"/></mxCell><mxCell id="pubb" value="Public subnet B / 10.0.16.0/20" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="935" y="485" width="755" height="280" as="geometry"/></mxCell><mxCell id="aing" value="VPC Link / 内部ALB&#xa;複数AZへの論理配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="115" y="555" width="320" height="80" as="geometry"/></mxCell><mxCell id="bing" value="VPC Link / 内部ALB&#xa;同じリソースのAZ側配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="555" width="320" height="80" as="geometry"/></mxCell><mxCell id="atask" value="ECSタスク配置候補&#xa;public IP / SG TCP8000" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="115" y="660" width="320" height="75" as="geometry"/></mxCell><mxCell id="btask" value="ECSタスク配置候補&#xa;実タスク数はdesired_count次第" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="660" width="320" height="75" as="geometry"/></mxCell><mxCell id="nata" value="NAT Gateway A + EIP&#xa;同AZ privateの外向き通信" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="575" width="330" height="110" as="geometry"/></mxCell><mxCell id="natb" value="NAT Gateway B + EIP&#xa;同AZ privateの外向き通信" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1325" y="575" width="330" height="110" as="geometry"/></mxCell><mxCell id="pria" value="Private subnet A / 10.0.32.0/20" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="90" y="825" width="755" height="300" as="geometry"/></mxCell><mxCell id="prib" value="Private subnet B / 10.0.48.0/20" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="935" y="825" width="755" height="300" as="geometry"/></mxCell><mxCell id="rta" value="Private RT-A&#xa;0.0.0.0/0 → NAT-A&#xa;S3・DDB prefix → Gateway EP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="115" y="900" width="320" height="120" as="geometry"/></mxCell><mxCell id="rtb" value="Private RT-B&#xa;0.0.0.0/0 → NAT-B&#xa;S3・DDB prefix → Gateway EP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="900" width="320" height="120" as="geometry"/></mxCell><mxCell id="epa" value="Interface EP ENI&#xa;ECR API / ECR DKR / Logs&#xa;private DNS、TCP443" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="900" width="330" height="120" as="geometry"/></mxCell><mxCell id="epb" value="Interface EP ENI&#xa;ECR API / ECR DKR / Logs&#xa;VPC CIDRからTCP443許可" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1325" y="900" width="330" height="120" as="geometry"/></mxCell><mxCell id="epgw" value="VPC Gateway Endpoints：S3 / DynamoDB&#xa;コード上のroute table associationはprivate RT向け。publicタスクの通信経路は各サービスのDNS・経路を別途確認。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="120" y="1190" width="1530" height="80" as="geometry"/></mxCell><mxCell id="caveat" value="新規VPCのCIDR式：public=cidrsubnet(vpc_cidr,4,i)、private=cidrsubnet(vpc_cidr,4,i+AZ数)。&#xa;既存VPC採用時はこのネットワークを作成しない。vpc_id + public/private subnet IDsから実際のCIDRを確認する。&#xa;AZ名・region・CIDR変更時は図も更新。AWS予約IPは各subnetの先頭4個と末尾1個。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1340" width="1680" height="130" as="geometry"/></mxCell><mxCell id="e16" value="双方向の論理経路" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="igw" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="public route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nata" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="public route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="natb" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="外向き default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rta" target="nata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="外向き default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rtb" target="natb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="HTTP8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aing" target="atask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="HTTP8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bing" target="btask"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page-3" name="03 SaaS・任意Gateway"><mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="03 / 外部SaaS・クラウド連携と任意Gateway" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1740" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="破線は選択・設定・配備に依存。SaaS契約・有効化は実環境未確認。Langfuse / LiteLLMを必須の外部SaaSとして扱わない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=15;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="1740" height="60" as="geometry"/></mxCell><mxCell id="aws" value="AWS側：Control Plane / 実行エージェント" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff1dc;fillOpacity=30;strokeColor=#d78b25;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1040" height="960" as="geometry"/></mxCell><mxCell id="cp" value="Control Plane / ブラウザ&#xa;認証設定・資産参照・配備" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="330" height="115" as="geometry"/></mxCell><mxCell id="agent" value="業務エージェント&#xa;直接Bedrock、またはGateway" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="345" width="350" height="115" as="geometry"/></mxCell><mxCell id="bedrock" value="AWS Bedrock / AgentCore&#xa;Bedrock Mantle等&#xa;AWSサービス（外部SaaSではない）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1dc;strokeColor=#d78b25;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="1040" width="350" height="120" as="geometry"/></mxCell><mxCell id="gw" value="任意配備：LiteLLM Gateway（渡されたVPC/subnetを使用）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="70" y="555" width="930" height="400" as="geometry"/></mxCell><mxCell id="gwalb" value="内部 ALB :4000&#xa;public subnet" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="110" y="630" width="330" height="85" as="geometry"/></mxCell><mxCell id="litellm" value="ECS LiteLLM :4000&#xa;private subnet / public IPなし" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="350" height="85" as="geometry"/></mxCell><mxCell id="pg" value="RDS PostgreSQL&#xa;private / TCP5432" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e5f7;strokeColor=#8262a5;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="110" y="800" width="330" height="90" as="geometry"/></mxCell><mxCell id="redis" value="ElastiCache Redis&#xa;private / TCP6379" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e5f7;strokeColor=#8262a5;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="600" y="800" width="350" height="90" as="geometry"/></mxCell><mxCell id="ext" value="外部サービス：接続候補 / 環境ごとに有効化" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5e9f5;fillOpacity=30;strokeColor=#a171a4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1130" y="260" width="610" height="960" as="geometry"/></mxCell><mxCell id="idp" value="外部OIDC IdP（任意・いずれか）&#xa;Microsoft Entra ID / Okta / Auth0&#xa;Generic OIDC / HTTPS443" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5e9f5;strokeColor=#a171a4;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="345" width="530" height="130" as="geometry"/></mxCell><mxCell id="cloud" value="他クラウド・SaaSコネクタ（任意）&#xa;Azure / GCP / Copilot Studio&#xa;認証・管理API / HTTPS443" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5e9f5;strokeColor=#a171a4;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="600" width="530" height="130" as="geometry"/></mxCell><mxCell id="registry" value="Docker Hub（条件付き）&#xa;ビルド時のイメージ取得 / HTTPS443&#xa;runtimeのモデルSaaSとは別用途" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5e9f5;strokeColor=#a171a4;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="870" width="530" height="130" as="geometry"/></mxCell><mxCell id="lf" value="Langfuseは別Foundationでセルフホスト可&#xa;ホストURLは設定で解決 → 詳細04&#xa;Langfuse Cloud利用を既定と断定しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1030" width="500" height="140" as="geometry"/></mxCell><mxCell id="guard" value="接続先FQDNとIPは動的・環境依存。AWS/IdP/他クラウドの公開IPを固定CIDRとして図に埋め込まない。&#xa;OIDCのトークン交換・Discovery/JWKS、他クラウドの収集先はそれぞれ異なる経路。&#xa;ローカルGatewayのOpenAIモデル設定はbedrock_mantle経由。OpenAI直接APIへの必須接続を仮定しない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1270" width="1680" height="145" as="geometry"/></mxCell><mxCell id="e23" value="OIDC / Discovery・JWKS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="idp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="コネクタ有効時 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="cloud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="Gateway設定時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="gwalb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="Gateway利用時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="gwalb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="TCP4000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gwalb" target="litellm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="TCP5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="litellm" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="TCP6379" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="litellm" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="外向き HTTPS443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="litellm" target="bedrock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="直接SDK経路" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="bedrock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-external" value="CodeBuild / ビルド時の取得" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="155" width="390" height="70" as="geometry"/></mxCell><mxCell id="external-docker" value="イメージ取得 HTTPS443 / 条件付き" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9c6d9d;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="build-external" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page-4" name="04 Foundation・Langfuse"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="04 / Foundation Stack — Langfuseセルフホストのネットワーク" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1740" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="templates/foundation-stack/iac/terraform（ECS版）| EKS版はこのページの対象外。既存VPC利用・alb_schemeにより構成が変わる。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;fontSize=15;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="1740" height="60" as="geometry"/></mxCell><mxCell id="fvpc" value="Foundation VPC（新規作成時）：既定 10.0.0.0/16 — Control Plane VPCと同一と仮定しない" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1700" height="780" as="geometry"/></mxCell><mxCell id="fa" value="AZ[0]：利用可能AZの先頭（名前はregion依存）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="795" height="690" as="geometry"/></mxCell><mxCell id="fb" value="AZ[1]：利用可能AZの2番目" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e5f1e6;fillOpacity=30;strokeColor=#58845a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="910" y="350" width="795" height="690" as="geometry"/></mxCell><mxCell id="fpa" value="Public A：10.0.0.0/24&#xa;cidrsubnet(vpc_cidr,8,0)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="105" y="420" width="330" height="110" as="geometry"/></mxCell><mxCell id="fpb" value="Public B：10.0.1.0/24&#xa;cidrsubnet(vpc_cidr,8,1)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="945" y="420" width="330" height="110" as="geometry"/></mxCell><mxCell id="fnat" value="NAT Gateway ×1 + EIP&#xa;public[0]に配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="475" y="420" width="340" height="110" as="geometry"/></mxCell><mxCell id="fpri1" value="Private A：10.0.10.0/24&#xa;cidrsubnet(vpc_cidr,8,10)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="105" y="710" width="330" height="110" as="geometry"/></mxCell><mxCell id="fpri2" value="Private B：10.0.11.0/24&#xa;cidrsubnet(vpc_cidr,8,11)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="945" y="710" width="330" height="110" as="geometry"/></mxCell><mxCell id="work" value="private subnetへ配置&#xa;ECS：Langfuse Web / Worker / ClickHouse&#xa;データ：PostgreSQL / Redis / EFS等" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="485" y="855" width="800" height="135" as="geometry"/></mxCell><mxCell id="falb" value="Langfuse ALB :80 → Web :3000&#xa;alb_scheme=internal → private&#xa;それ以外 → public（実設定を確認）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="580" height="110" as="geometry"/></mxCell><mxCell id="fuser" value="利用者 / トレース・管理API&#xa;LangfuseホストURLは配備出力から解決" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#66837e;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="680" height="100" as="geometry"/></mxCell><mxCell id="froute" value="private RT：0.0.0.0/0 → 共通NAT&#xa;両AZのprivateで同じNATを参照&#xa;単一NATのAZ依存を認識する" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f1e6;strokeColor=#58845a;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="510" width="700" height="110" as="geometry"/></mxCell><mxCell id="overlap" value="注意：両スタックの既定VPC CIDRは10.0.0.0/16で重複。&#xa;別VPCを相互接続する場合、Peering/TGW等の経路だけを追加しても重複CIDRの問題は解消しない。&#xa;接続方式・既存VPC再利用・CIDR再設計は環境に合わせて決定。現在のRepoからVPC間接続済みとは判断していない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1120" width="1630" height="140" as="geometry"/></mxCell><mxCell id="e32" value="設定された入口 / HTTPS等" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fuser" target="falb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="HTTP3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ff