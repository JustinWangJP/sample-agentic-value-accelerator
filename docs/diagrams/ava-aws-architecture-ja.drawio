tColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="260" height="90" as="geometry"/></mxCell><mxCell id="ecs" value="ECS Fargate / FastAPI&#xa;public subnet / public IP&#xa;TCP :8000" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="670" width="350" height="115" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB&#xa;管理データ・配備状態" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e5f7;strokeColor=#8262a5;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="910" width="260" height="95" as="geometry"/></mxCell><mxCell id="s3" value="S3 / ECR&#xa;成果物・コンテナ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e5f7;strokeColor=#8262a5;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="260" height="95" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch / Secrets Manager&#xa;ログ・秘密情報" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e5f7;strokeColor=#8262a5;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="690" y="910" width="310" height="95" as="geometry"/></mxCell><mxCell id="pipeline" value="Step Functions → CodeBuild&#xa;IaC・Docker・UIの配備" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="340" width="380" height="115" as="geometry"/></mxCell><mxCell id="runtime" value="業務エージェント&#xa;AgentCore等 / Bedrock&#xa;構成はユースケース・pattern依存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#d18a2d;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="535" width="380" height="115" as="geometry"/></mxCell><mxCell id="saas" value="任意の外部連携&#xa;Entra ID / Okta / Auth0&#xa;Azure / GCP等 → 03" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5e9f5;strokeColor=#a171a4;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="780" width="380" height="125" as="geometry"/></mxCell><mxCell id="note" value="UI配信とAPI入口は別系統。&#xa;CloudFront→管理ALBをこの図では仮定しない。&#xa;ALBはinternalだが、ECSタスクはpublic IP割当あり。&#xa;private subnetへの配置と混同しない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff9db;strokeColor=#c1a247;fontColor=#193b3b;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1120" width="1670" height="120" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="cdn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ログイン / HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="DNS / 条件付き" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9c6d9d;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dns" target="cdn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="S3オリジン" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cdn" target="s3ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="VPC_LINK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="link"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="HTTP 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="link" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="HTTP 8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alb" target="ecs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="JWT鍵取得 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0;" edge="1" parent="1" source="ecs" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="AWS SDK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ecs" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="成果物 / AWS API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#167467;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ecs" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="SDK / ログ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow